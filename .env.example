# === LLM Provider Keys ===
GROQ_API_KEY=gsk_xxxxx
GOOGLE_API_KEY=AIza-xxxxx        # (ถ้าจะใช้ Gemini เป็น fallback)

# === Default Provider / Routing ===
LLM_PROVIDER=groq
GROQ_BASE_URL=https://api.groq.com/openai/v1

# === App Environment / Privacy ===
APP_ENV=dev                       # dev | prod
DISABLE_TELEMETRY=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# === Budget / Rate Guard ===
DAILY_MAX_TOKENS=300000           # ลิมิตต่อวัน (รวม prompt+completion)
DAILY_MAX_REQUESTS=0              # 0 = ไม่จำกัดตามจำนวนคำขอ (ใช้โทเคนเป็นตัวคุม)
