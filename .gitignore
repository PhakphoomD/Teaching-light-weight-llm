# ============================================
# Project-specific ignores
# ============================================

# Local LLM models (Llama, etc.) - require license agreement
models/

# Debug logs (large files, keep locally only)
logs/simplified/debug/

# Generated analysis files
logs/analysis/

# FAISS index and memory files (generated during runtime)
logs/simplified/faiss.*
logs/simplified/memory.jsonl

# New-core run outputs (T2.6) — generated per run under runs/<run_id>/
# (rounds.jsonl, summary.jsonl, config_used.json, memory/); reproducible from
# the experiment config + seed + git commit recorded inside summary.jsonl, so
# outputs stay local, not committed (mirrors logs/simplified/* above).
# Experiment artifacts (ADR-034): raw generations ignored, small evidence tracked.
# NOTE: the `!runs/**/` line is load-bearing -- without it git never descends into
# runs/<study>/<condition>/ and every negation below is dead.
# NOTE: gitignore has no trailing-comment syntax -- keep comments on their own lines.
runs/**
!runs/**/
!runs/**/summary.jsonl
!runs/**/config_used.json
!runs/**/manifest.json
!runs/**/README.md
# The scoring half of every per-round log: same rows, generated text removed.
# 3.6 MB against 20 MB, and it is what every published interval, McNemar and
# figure is computed from -- so a clone can check the numbers without a rerun.
# Written by scripts/export_analysis_rows.py.
!runs/**/rounds-analysis.jsonl
!runs/**/*-analysis.jsonl
!runs/**/retrieval_log*.jsonl
# Rebuildable search indexes (was: data/rag/) -- python -m tools.rag.cli
indexes/
# Third-party datasets -- see scripts/dataset/fetch_wixqa.py
data/external/

# RAG retrieval indexes (T3.2) — data/rag/<name>/{faiss.index,passages.jsonl,
# faiss.ids.json,manifest.json,build_report.md}; the binary index is rebuildable
# via `python -m tools.rag.cli` (§0.3), so it stays local, not committed.

# Legacy code (deprecated)
src/simplified/legacy/

# API keys and secrets
.env

# Working notes: task specifications and design notes written before each piece of work.
# Substance absorbed into docs/EXPERIMENT_RESULTS.md; full text at commit 64a39cc372a3.
/docs/plan/

# Subagent working memory: notes each specialist keeps for itself between sessions.
# Internal to how the work is done, not part of what the work produced.
/.claude/agent-memory/
